<Window
  x:Class="SistemaPatentesCIF.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:SistemaPatentesCIF"
  mc:Ignorable="d"
  Title="MainWindow"
  Height="700"
  Width="900"
  MinHeight="700"
  MinWidth="900"
  Background="#111827"
  ResizeMode="NoResize"
>
  <Window.Resources>
    <SolidColorBrush x:Key="BlackThemeBackground" Color="#111827" />
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Margin" Value="5" />
      <Setter Property="Background" Value="#4B5563" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="WhiteSmoke" />
    </Style>
  </Window.Resources>

  <Grid Margin="10" Background="{StaticResource BlackThemeBackground}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="480" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Panel izquierdo -->
    <StackPanel Grid.Column="0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button
          Content="📂 Cargar Imagen"
          Margin="0,2,5,2"
          Width="130"
          Click="CargarImagen_Click"
        />
        <Button Content="📷 Abrir Cámara" Margin="0,2,5,2" Width="125" />
        <Button Content="⏻ Salir" Margin="0,2,0,2" Width="100" Click="Salir_Click" />
      </StackPanel>

      <!-- Imagen -->
      <Border BorderBrush="Gray" BorderThickness="1" Margin="5,20,5,5">
        <Grid>
          <Image x:Name="ImgPreview" Stretch="UniformToFill" Height="400" />
          <Canvas x:Name="overlayCanvas" IsHitTestVisible="False" />
        </Grid>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button
          Content="💾 Guardar Resultados"
          Margin="10"
          Width="200"
          HorizontalAlignment="Center"
        />
        <Button
          Content="🗑️ Limpiar Resultados"
          Margin="10"
          Width="200"
          HorizontalAlignment="Center"
          Click="Limpiar_Click"
        />
      </StackPanel>
      <TextBlock
        Text="© 2026 Sistema de Patentes CIF&#10;Centro de Investigaciones Forense&#10;Todos los derechos reservados"
        FontSize="12"
        HorizontalAlignment="Center"
        TextAlignment="Center"
        Margin="10"
      />

      <!-- Barra de estado -->
      <StatusBar
        x:Name="StatusBar"
        Margin="5,40,5,5"
        Background="{StaticResource BlackThemeBackground}"
      >
        <StatusBarItem>
          <TextBlock x:Name="StatusBarReadyText" Text="Listo" />
        </StatusBarItem>
        <StatusBarItem>
          <ProgressBar
            x:Name="OcrProgress"
            Width="200"
            Height="15"
            Minimum="0"
            Maximum="100"
            Background="#4B5563"
          />
        </StatusBarItem>
        <StatusBarItem>
          <TextBlock x:Name="StatusBarInfo" Text="Esperando acción..." />
        </StatusBarItem>
      </StatusBar>
    </StackPanel>

    <!-- Panel derecho -->
    <StackPanel Grid.Column="1" Margin="5">
      <TextBlock Text="Placa Detectada:" FontWeight="Bold" FontSize="18" />
      <TextBlock
        x:Name="PlacaDetectada"
        Text="-"
        FontSize="40"
        FontWeight="Bold"
        Foreground="Green"
        Margin="0,5,0,15"
      />
      <Line X1="0" Y1="0" X2="400" Y2="0" Stroke="Gray" StrokeThickness="2" Margin="0,0,0,15" />
      <TextBlock x:Name="TxtConfidencePlate" Text="Confianza: -" Margin="0,0,0,15" />
      <StackPanel Orientation="Horizontal">
        <TextBlock
          x:Name="PaisDetectado"
          Text="País: -"
          Margin="0,0,0,15"
          VerticalAlignment="Center"
        />
        <TextBlock x:Name="ConfianzaPais" Text="Confianza País: -" Margin="40,0,0,15" />
      </StackPanel>

      <Line X1="0" Y1="0" X2="400" Y2="0" Stroke="Gray" StrokeThickness="2" Margin="0,0,0,15" />
      <TextBlock Text="Historial de Lecturas:" FontWeight="Bold" FontSize="16" />
      <DataGrid
        x:Name="PlateDataGrid"
        AutoGenerateColumns="False"
        Height="340"
        Margin="0,5,0,10"
        BorderBrush="CadetBlue"
        BorderThickness="2"
        SelectedCellsChanged="PlateDataGrid_SelectedCellsChanged"
      >
        <DataGrid.Columns>
          <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="1.2*" />
          <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="*" />
          <DataGridTextColumn
            x:Name="DataConfidence"
            Header="Confianza"
            Binding="{Binding Confianza}"
            Width="0.7*"
          />
          <DataGridTemplateColumn Header="Estado" Width="0.5*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <!-- El Background se enlaza (Binding) a la propiedad del objeto -->
                <Border Background="{Binding ColorHex}" Width="20" Height="20" CornerRadius="10" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button
          Content="▶ Consultar Info Vehicular"
          Margin="5,5,10,5"
          Width="180"
          Click="GetVehicleInfo_Click"
        />
        <Button Content="📊 Exportar CSV" Margin="5" Width="150" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
