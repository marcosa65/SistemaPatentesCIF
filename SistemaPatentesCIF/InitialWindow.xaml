<Window x:Class="SistemaPatentesCIF.InitialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="ALPR Control Center"
        Height="820"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>

        <Thickness x:Key="DashBoardTitle">
            0,5,0,5
        </Thickness>
        <Thickness x:Key="DashBoardDescription">
            15,0,15,10
        </Thickness>
        <sys:Double x:Key="DashBoardLogoSize">
            45
        </sys:Double>

    </Window.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,10"
                    Height="230">

            <StackPanel.Background>

                <ImageBrush ImageSource="/images/cif_logo.png"
                            Stretch="None"
                            Opacity="1.0"
                            AlignmentX="Center"
                            AlignmentY="Top"/>

            </StackPanel.Background>

            <TextBlock Text="🚔 ALPR CONTROL CENTER"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,130,0,0"/>

            <TextBlock FontSize="14"
                       Foreground="#B0B0B0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center">

                Sistema de Reconocimiento Vehicular
                <LineBreak/>
                Centro de Investigaciones Forenses
                <LineBreak/>
                Poder Judicial de Formosa

            </TextBlock>

        </StackPanel>

        <!-- ESTADO -->

        <Border Grid.Row="1"
                Background="#252526"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Cámara"
                               Foreground="#AAAAAA"/>
                    <TextBlock Text="● Conectada"
                               Foreground="#4CAF50"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="API"
                               Foreground="#AAAAAA"/>
                    <TextBlock Text="● Disponible"
                               Foreground="#4CAF50"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Base de Datos"
                               Foreground="#AAAAAA"/>
                    <TextBlock Text="● Conectada"
                               Foreground="#4CAF50"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Última Detección"
                               Foreground="#AAAAAA"/>
                    <TextBlock Text="--:--"
                               Foreground="White"
                               FontWeight="Bold"/>
                </StackPanel>

            </Grid>

        </Border>

        <!-- MODULOS -->

        <UniformGrid Grid.Row="2"
                     Rows="2"
                     Columns="2">

            <!-- DETECCION -->

            <Button Style="{StaticResource DashboardButtonStyle}"
                    Click="DetectionButton_Click">

                <StackPanel>

                    <TextBlock Text="📷"
                               FontSize="45"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="DETECCIÓN"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource DashBoardTitle}"/>

                    <TextBlock Text="Procesar imágenes, videos y cámaras IP"
                               Foreground="#D0D0D0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="{StaticResource DashBoardDescription}"/>

                </StackPanel>

            </Button>

            <!-- CONSULTA -->

            <Button Style="{StaticResource DashboardButtonStyle}">

                <StackPanel>

                    <TextBlock Text="🚗"
                               FontSize="{StaticResource DashBoardLogoSize}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="CONSULTA VEHICULAR"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource DashBoardTitle}"/>

                    <TextBlock Text="Consultar vehículos mediante patente"
                               Foreground="#D0D0D0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="{StaticResource DashBoardDescription}"/>

                </StackPanel>

            </Button>

            <!-- HISTORIAL -->

            <Button Style="{StaticResource DashboardButtonStyle}"
                     Click="HistoryButton_Click">

                <StackPanel>

                    <TextBlock Text="📚"
                               FontSize="{StaticResource DashBoardLogoSize}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="HISTORIAL"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource DashBoardTitle}"/>

                    <TextBlock Text="Revisar registros y eventos"
                               Foreground="#D0D0D0"
                               TextAlignment="Center"
                               Margin="{StaticResource DashBoardDescription}"/>

                </StackPanel>

            </Button>

            <!-- INTELIGENCIA -->

            <Button Style="{StaticResource DashboardButtonStyle}"
                    Click="IntelligenceButton_Click">
                <StackPanel>

                    <TextBlock Text="📊"
                               FontSize="{StaticResource DashBoardLogoSize}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="INTELIGENCIA"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource DashBoardTitle}"/>

                    <TextBlock Text="Alertas, métricas y análisis"
                               Foreground="#D0D0D0"
                               TextAlignment="Center"
                               Margin="{StaticResource DashBoardDescription}"/>

                </StackPanel>

            </Button>

        </UniformGrid>

        <!-- RESUMEN -->

        <Border Grid.Row="3"
                Background="#252526"
                CornerRadius="10"
                Padding="15"
                Margin="10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Estado del Sistema"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Sistema listo para operar."
                               Margin="0,10,0,0"
                               Foreground="#D0D0D0"/>

                    <TextBlock Text="Esperando detecciones..."
                               Foreground="#D0D0D0"/>

                </StackPanel>

                <UniformGrid Grid.Column="1"
                             Rows="1"
                             Columns="3">

                    <StackPanel>

                        <TextBlock Text="0"
                                   FontSize="28"
                                   Foreground="#007ACC"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Hoy"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel>

                        <TextBlock Text="0"
                                   FontSize="28"
                                   Foreground="#00C853"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Únicos"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel>

                        <TextBlock Text="0"
                                   FontSize="28"
                                   Foreground="#FFB300"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Alertas"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </UniformGrid>

            </Grid>

        </Border>

    </Grid>

</Window>