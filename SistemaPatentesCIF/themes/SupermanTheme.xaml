<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ==================== FONDOS AZUL MARINO PROFUNDO ==================== -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="#0B1120"/>      <!-- Fondo principal ventana -->
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="#131C31"/>    <!-- Fondo tarjetas / contenedores -->
    <SolidColorBrush x:Key="BgElevatedBrush" Color="#1E2B4A"/>     <!-- Hover / selección -->

    <!-- ==================== BORDES Y ACENTOS SUPERMAN ==================== -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#27385E"/>   <!-- Bordes azul acero -->
    <SolidColorBrush x:Key="AccentAmberBrush" Color="#DC2626"/>    <!-- Rojo carmesí principal -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#EF4444"/>    <!-- Rojo brillante hover -->

    <!-- ==================== TEXTOS ==================== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>    <!-- Blanco hielo -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>  <!-- Gris azulado secundario -->
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>   <!-- Blanco sobre botones rojos -->

</ResourceDictionary>