<Window
  x:Class="SistemaPatentesCIF.views.VehicleHistoryDetailWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:SistemaPatentesCIF.views"
  mc:Ignorable="d"
  Title="Detalle Registral · Historial Vehicular"
  Height="680"
  Width="520"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  Icon="/images/app_icon.ico"
  Style="{StaticResource ModernDarkWindowStyle}"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <!-- Barra Superior -->
      <RowDefinition Height="*" />
      <!-- Ficha Técnica y Ubicación -->
      <RowDefinition Height="Auto" />
      <!-- Pie y Acciones -->
    </Grid.RowDefinitions>

    <!-- ==================== 1. BARRA SUPERIOR UNIFICADA ==================== -->
    <Border
      Grid.Row="0"
      BorderBrush="{DynamicResource BorderSubtleBrush}"
      BorderThickness="0,0,0,1"
      Padding="20,14"
    >
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button
            x:Name="BtnCloseTop"
            Content="← Volver"
            Style="{StaticResource SubtleBackButton}"
            Click="BtnClose_Click"
            Margin="0,0,14,0"
          />
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              Text="FICHA DEL VEHÍCULO"
              Foreground="{DynamicResource AccentAmberBrush}"
              FontSize="16"
              FontWeight="Bold"
            />
            <TextBlock
              Text="Información registral vinculada al historial"
              Foreground="{DynamicResource TextSecondaryBrush}"
              FontSize="11"
            />
          </StackPanel>
        </StackPanel>

        <Border
          Style="{StaticResource AmberBadgeBorder}"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
        >
          <TextBlock
            Text="HISTORIAL · CIF"
            Foreground="{DynamicResource TextOnAccentBrush}"
            FontWeight="Bold"
            FontSize="11"
          />
        </Border>
      </Grid>
    </Border>

    <!-- ==================== 2. CONTENIDO PRINCIPAL ==================== -->
    <StackPanel Grid.Row="1" Margin="20,16,20,12">
      <!-- CAJA DESTACADA DE DOMINIO / PATENTE -->
      <Border
        Background="{DynamicResource BgSecondaryBrush}"
        BorderBrush="{DynamicResource AccentAmberBrush}"
        BorderThickness="1.5"
        CornerRadius="12"
        Padding="16,12"
        Margin="0,0,0,16"
      >
        <StackPanel HorizontalAlignment="Center">
          <TextBlock
            Text="DOMINIO SELECCIONADO"
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextSecondaryBrush}"
            HorizontalAlignment="Center"
          />
          <TextBlock
            x:Name="TxtPlate"
            Text="{Binding Plate, FallbackValue='-', TargetNullValue='-'}"
            FontSize="36"
            FontWeight="Bold"
            Foreground="{DynamicResource AccentAmberBrush}"
            HorizontalAlignment="Center"
            Margin="0,2,0,0"
          />
        </StackPanel>
      </Border>

      <!-- TARJETA 1: DATOS REGISTRALES DEL VEHÍCULO -->
      <Border Style="{StaticResource DarkCardBorderStyle}" Padding="18,14" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Path
              Data="M18.92,6.01C18.72,5.42 18.16,5 17.5,5H6.5C5.84,5 5.29,5.42 5.08,6.01L3,12V20A1,1 0 0,0 4,21H5A1,1 0 0,0 6,20V19H18V20A1,1 0 0,0 19,21H20A1,1 0 0,0 21,20V12L18.92,6.01M6.5,16A1.5,1.5 0 0,1 5,14.5A1.5,1.5 0 0,1 6.5,13A1.5,1.5 0 0,1 8,14.5A1.5,1.5 0 0,1 6.5,16M17.5,16A1.5,1.5 0 0,1 16,14.5A1.5,1.5 0 0,1 17.5,13A1.5,1.5 0 0,1 19,14.5A1.5,1.5 0 0,1 17.5,16M5,11L6.5,6.5H17.5L19,11H5Z"
              Fill="{DynamicResource AccentAmberBrush}"
              Width="16"
              Height="16"
              Stretch="Uniform"
              Margin="0,0,8,0"
            />
            <TextBlock
              Text="ESPECIFICACIONES DEL RODADO"
              FontSize="13"
              FontWeight="Bold"
              Foreground="{DynamicResource TextPrimaryBrush}"
            />
          </StackPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="34" />
              <RowDefinition Height="34" />
              <RowDefinition Height="34" />
              <RowDefinition Height="34" />
              <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- Fila 0: Marca -->
            <Border
              Grid.Row="0"
              Grid.ColumnSpan="2"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,0,1"
            />
            <TextBlock
              Grid.Row="0"
              Grid.Column="0"
              Text="Marca"
              Foreground="{DynamicResource TextSecondaryBrush}"
              VerticalAlignment="Center"
            />
            <TextBlock
              x:Name="TxtMake"
              Grid.Row="0"
              Grid.Column="1"
              Text="{Binding Make, FallbackValue='-', TargetNullValue='-'}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              FontWeight="SemiBold"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
            />

            <!-- Fila 1: Modelo -->
            <Border
              Grid.Row="1"
              Grid.ColumnSpan="2"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,0,1"
            />
            <TextBlock
              Grid.Row="1"
              Grid.Column="0"
              Text="Modelo"
              Foreground="{DynamicResource TextSecondaryBrush}"
              VerticalAlignment="Center"
            />
            <TextBlock
              x:Name="TxtModel"
              Grid.Row="1"
              Grid.Column="1"
              Text="{Binding Model, FallbackValue='-', TargetNullValue='-'}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              FontWeight="SemiBold"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
            />

            <!-- Fila 2: Año -->
            <Border
              Grid.Row="2"
              Grid.ColumnSpan="2"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,0,1"
            />
            <TextBlock
              Grid.Row="2"
              Grid.Column="0"
              Text="Año de Fabricación"
              Foreground="{DynamicResource TextSecondaryBrush}"
              VerticalAlignment="Center"
            />
            <TextBlock
              x:Name="TxtYear"
              Grid.Row="2"
              Grid.Column="1"
              Text="{Binding Year, FallbackValue='-', TargetNullValue='-'}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              FontWeight="SemiBold"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
            />

            <!-- Fila 3: Tipo -->
            <Border
              Grid.Row="3"
              Grid.ColumnSpan="2"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,0,1"
            />
            <TextBlock
              Grid.Row="3"
              Grid.Column="0"
              Text="Tipo de Vehículo"
              Foreground="{DynamicResource TextSecondaryBrush}"
              VerticalAlignment="Center"
            />
            <TextBlock
              x:Name="TxtVehicleKind"
              Grid.Row="3"
              Grid.Column="1"
              Text="{Binding VehicleKind, FallbackValue='-', TargetNullValue='-'}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              FontWeight="SemiBold"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
            />

            <!-- Fila 4: Formato -->
            <TextBlock
              Grid.Row="4"
              Grid.Column="0"
              Text="Formato de Placa"
              Foreground="{DynamicResource TextSecondaryBrush}"
              VerticalAlignment="Center"
            />
            <TextBlock
              x:Name="TxtPlateFormat"
              Grid.Row="4"
              Grid.Column="1"
              Text="{Binding PlateFormat, FallbackValue='-', TargetNullValue='-'}"
              Foreground="{DynamicResource AccentAmberBrush}"
              FontWeight="SemiBold"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
            />
          </Grid>
        </StackPanel>
      </Border>

      <!-- TARJETA 2: RADICACIÓN / UBICACIÓN ACTUAL -->
      <Border Style="{StaticResource DarkCardBorderStyle}" Padding="18,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Path
              Data="M12,2C8.13,2 5,5.13 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9C19,5.13 15.87,2 12,2M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5Z"
              Fill="{DynamicResource AccentAmberBrush}"
              Width="16"
              Height="16"
              Stretch="Uniform"
              Margin="0,0,8,0"
            />
            <TextBlock
              Text="RADICACIÓN GEOGRÁFICA"
              FontSize="13"
              FontWeight="Bold"
              Foreground="{DynamicResource TextPrimaryBrush}"
            />
          </StackPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="34" />
              <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- Fila 0: Provincia -->
            <Border
              Grid.Row="0"
              Grid.ColumnSpan="2"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,0,1"
            />
            <TextBlock
              Grid.Row="0"
              Grid.Column="0"
              Text="Provincia"
              Foreground="{DynamicResource TextSecondaryBrush}"
              VerticalAlignment="Center"
            />
            <TextBlock
              x:Name="TxtProvince"
              Grid.Row="0"
              Grid.Column="1"
              Text="{Binding Province, FallbackValue='-', TargetNullValue='-'}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              FontWeight="SemiBold"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
            />

            <!-- Fila 1: Ciudad -->
            <TextBlock
              Grid.Row="1"
              Grid.Column="0"
              Text="Ciudad / Localidad"
              Foreground="{DynamicResource TextSecondaryBrush}"
              VerticalAlignment="Center"
            />
            <TextBlock
              x:Name="TxtCity"
              Grid.Row="1"
              Grid.Column="1"
              Text="{Binding City, FallbackValue='-', TargetNullValue='-'}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              FontWeight="SemiBold"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
            />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ==================== 3. PIE Y ACCIONES ==================== -->
    <Border
      Grid.Row="2"
      BorderBrush="{DynamicResource BorderSubtleBrush}"
      BorderThickness="0,1,0,0"
      Padding="20,12"
    >
      <Grid>
        <Button
          x:Name="BtnGenerateReport"
          Content="Generar reporte"
          Style="{StaticResource OutlineAmberButton}"
          HorizontalAlignment="Left"
          Click="BtnGenerateReport_Click"
        />

        <Button
          x:Name="BtnCloseBottom"
          Content="Cerrar"
          Style="{StaticResource PrimaryAccentButton}"
          HorizontalAlignment="Right"
          Click="BtnClose_Click"
        />
      </Grid>
    </Border>
  </Grid>
</Window>
