<Window x:Class="SistemaPatentesCIF.VehicleInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        Title="Consulta Vehicular · ALPR"
        Height="820"
        Width="1120"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernDarkWindowStyle}"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Barra Superior -->
            <RowDefinition Height="Auto"/>
            <!-- Barra de Búsqueda Manual -->
            <RowDefinition Height="*"/>
            <!-- Mapa y Ficha Técnica -->
            <RowDefinition Height="Auto"/>
            <!-- Pie / Acciones -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. BARRA SUPERIOR UNIFICADA ==================== -->
        <Border Grid.Row="0" 
                BorderBrush="{StaticResource BorderSubtleBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← Volver" 
                            Style="{StaticResource SubtleBackButton}" 
                            Click="BtnBack_Click"
                            Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CONSULTA VEHICULAR" 
                                   Foreground="{StaticResource AccentAmberBrush}" 
                                   FontSize="18" 
                                   FontWeight="Bold"/>
                        <TextBlock Text="Verificación Registral y Geolocalización de Radicación" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource AmberBadgeBorder}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="REGISTRO · GEO" 
                               Foreground="{StaticResource TextOnAccentBrush}" 
                               FontWeight="Bold" 
                               FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 2. PANEL DE BÚSQUEDA (MODO MANUAL) ==================== -->
        <Border x:Name="SearchPanel"
                Grid.Row="1"
                Style="{StaticResource DarkCardBorderStyle}"
                Padding="16"
                Margin="24,16,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Path Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.49L20.49,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14Z"
                          Fill="{StaticResource AccentAmberBrush}"
                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="DOMINIO / PATENTE:"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"/>
                </StackPanel>

                <TextBox x:Name="TxtSearchPlate"
                         Grid.Column="1"
                         Style="{StaticResource DarkTextBoxStyle}"
                         TextAlignment="Center"
                         FontSize="20"
                         FontWeight="Bold"
                         Foreground="{StaticResource AccentAmberBrush}"
                         CharacterCasing="Upper"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,0"/>

                <Button x:Name="BtnSearchPlate"
                        Grid.Column="2"
                        Content="Consultar Dominio"
                        Style="{StaticResource PrimaryAccentButton}"
                        Click="LookupButton_Click"/>

                <TextBlock Grid.Column="3"
                           Text="Ingrese el dominio sin espacios ni guiones (Ej: AA123BB o ABC123)"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ==================== 3. CONTENIDO PRINCIPAL (MAPA + DATOS) ==================== -->
        <Grid Grid.Row="2" Margin="24,16,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: INFORMACIÓN GEOGRÁFICA -->
            <Border Grid.Column="0"
                    Style="{StaticResource DarkCardBorderStyle}"
                    Padding="16"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Data="M12,2C8.13,2 5,5.13 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9C19,5.13 15.87,2 12,2M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5Z"
                              Fill="{StaticResource AccentAmberBrush}"
                              Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="UBICACIÓN Y RADICACIÓN GEOGRÁFICA"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{StaticResource BgPrimaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <gmap:GMapControl x:Name="GMapControl"
                                          Background="#0C0D12"/>
                    </Border>
                </Grid>
            </Border>

            <!-- PANEL DERECHO: FICHA TÉCNICA DEL VEHÍCULO -->
            <Border Grid.Column="1"
                    Style="{StaticResource DarkCardBorderStyle}"
                    Padding="20"
                    Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título de Ficha -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Path Data="M18.92,6.01C18.72,5.42 18.16,5 17.5,5H6.5C5.84,5 5.29,5.42 5.08,6.01L3,12V20A1,1 0 0,0 4,21H5A1,1 0 0,0 6,20V19H18V20A1,1 0 0,0 19,21H20A1,1 0 0,0 21,20V12L18.92,6.01M6.5,16A1.5,1.5 0 0,1 5,14.5A1.5,1.5 0 0,1 6.5,13A1.5,1.5 0 0,1 8,14.5A1.5,1.5 0 0,1 6.5,16M17.5,16A1.5,1.5 0 0,1 16,14.5A1.5,1.5 0 0,1 17.5,13A1.5,1.5 0 0,1 19,14.5A1.5,1.5 0 0,1 17.5,16M5,11L6.5,6.5H17.5L19,11H5Z"
                              Fill="{StaticResource AccentAmberBrush}"
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="FICHA TÉCNICA DEL VEHÍCULO"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Caja Destacada de Patente -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BgPrimaryBrush}"
                            BorderBrush="{StaticResource AccentAmberBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="16,10"
                            Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="DOMINIO CONSULTADO"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPlate"
                                       Text="-"
                                       FontSize="38"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentAmberBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tabla de Especificaciones -->
                    <StackPanel Grid.Row="2">
                        <!-- Marca -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                            <Grid>
                                <TextBlock Text="Marca" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock x:Name="TxtMake" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Modelo -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                            <Grid>
                                <TextBlock Text="Modelo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock x:Name="TxtModel" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Año -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                            <Grid>
                                <TextBlock Text="Año" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock x:Name="TxtAnio" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Formato -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                            <Grid>
                                <TextBlock Text="Formato" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock x:Name="TxtPlateFormat" Text="-" Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Tipo -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                            <Grid>
                                <TextBlock Text="Tipo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock x:Name="TxtVehicleKind" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Provincia -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                            <Grid>
                                <TextBlock Text="Provincia" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock x:Name="TxtProvince" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Ciudad -->
                        <Border Padding="4,10">
                            <Grid>
                                <TextBlock Text="Ciudad" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock x:Name="TxtCity" Text="-" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Botón de Informe Pericial -->
                    <Button Grid.Row="3"
                            Content="Generar Informe Pericial"
                            Style="{StaticResource PrimaryAccentButton}"
                            Margin="0,14,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 4. PIE DE VENTANA ==================== -->
        <Border Grid.Row="3" 
                BorderBrush="{StaticResource BorderSubtleBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="24,12">
            <TextBlock Text="© 2026 Sistema de Patentes CIF · Centro de Investigaciones Forenses · Poder Judicial de Formosa" 
                       Foreground="{StaticResource TextSecondaryBrush}" 
                       FontSize="12" 
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
