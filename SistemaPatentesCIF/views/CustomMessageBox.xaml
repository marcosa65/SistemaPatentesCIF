<Window x:Class="SistemaPatentesCIF.views.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaPatentesCIF.views"
        mc:Ignorable="d"
        Title="Mensaje del Sistema"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource AccentAmberBrush}"
            BorderThickness="1.5"
            CornerRadius="12"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Barra de Título Arrastrable -->
                <RowDefinition Height="Auto"/>
                <!-- Cuerpo del Mensaje -->
                <RowDefinition Height="Auto"/>
                <!-- Botones de Acción -->
            </Grid.RowDefinitions>

            <!-- 1. BARRA SUPERIOR -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    Padding="18,12"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="{DynamicResource AccentAmberBrush}"
                                Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtTitle"
                                   Text="AVISO DEL SISTEMA"
                                   Foreground="{DynamicResource AccentAmberBrush}"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                    </StackPanel>

                    <Button Content="✕"
                            Style="{StaticResource SubtleBackButton}"
                            Padding="8,2"
                            FontSize="12"
                            HorizontalAlignment="Right"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 2. CUERPO CON ICONO VECTORIAL Y TEXTO -->
            <Grid Grid.Row="1" Margin="22,20,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Contenedor del Icono -->
                <Border x:Name="IconContainer"
                        Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="22"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Top"
                        Margin="0,0,16,0">
                    <Path x:Name="IconPath"
                          Fill="{DynamicResource AccentAmberBrush}"
                          Width="22" Height="22"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                </Border>

                <!-- Texto del Mensaje -->
                <TextBlock x:Name="TxtMessage"
                           Grid.Column="1"
                           Text="Mensaje informativo de la aplicación."
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           LineHeight="20"/>
            </Grid>

            <!-- 3. PIE CON BOTONES DINÁMICOS -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSecondary"
                            Content="Cancelar"
                            Style="{StaticResource SubtleBackButton}"
                            MinWidth="95"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"
                            Click="BtnSecondary_Click"/>

                    <Button x:Name="BtnPrimary"
                            Content="Aceptar"
                            Style="{StaticResource PrimaryAccentButton}"
                            MinWidth="105"
                            Click="BtnPrimary_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
