<Window x:Class="SistemaPatentesCIF.views.DetectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaPatentesCIF.views"
        mc:Ignorable="d"
        Title="Detección de Patentes" 
        Height="820" 
        Width="1120"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernDarkWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. BARRA SUPERIOR UNIFICADA ==================== -->
        <Border Grid.Row="0" 
                BorderBrush="{StaticResource BorderSubtleBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← Volver" 
                            Style="{StaticResource SubtleBackButton}" 
                            Click="BtnBack_Click"
                            Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DETECCIÓN DE PATENTES" 
                                   Foreground="{StaticResource AccentAmberBrush}" 
                                   FontSize="18" 
                                   FontWeight="Bold"/>
                        <TextBlock Text="Procesamiento de Imágenes, Video y Reconocimiento OCR" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource AmberBadgeBorder}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="MÓDULO ALPR · OCR" 
                               Foreground="{StaticResource TextOnAccentBrush}" 
                               FontWeight="Bold" 
                               FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 2. CONTENIDO PRINCIPAL ==================== -->
        <Grid Grid.Row="1" Margin="24,16,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: VISOR Y CONTROLES -->
            <Border Grid.Column="0" 
                    Style="{StaticResource DarkCardBorderStyle}" 
                    Padding="16" 
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera del Visor + Botón Principal -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M9,2L7.17,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6A2,2 0 0,0 20,4H16.83L15,2H9M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                                  Fill="{StaticResource AccentAmberBrush}"
                                  Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="VISTA PREVIA DE CAPTURA"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Content="+ Cargar Imagen"
                                Style="{StaticResource PrimaryAccentButton}"
                                HorizontalAlignment="Right"
                                Click="LoadImageButton_Click"/>
                    </Grid>

                    <!-- Lienzo de Imagen y Overlay -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BgPrimaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6"
                            Margin="0,0,0,14">
                        <Grid>
                            <Image x:Name="imgPreview" Stretch="Uniform"/>
                            <Canvas x:Name="overlayCanvas" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- Botones de Acción Inferiores -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Guardar Resultados"
                                Style="{StaticResource OutlineAmberButton}"/>

                        <Button Grid.Column="2"
                                Content="Limpiar Vista"
                                Style="{StaticResource SubtleBackButton}"
                                Click="CleanButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- PANEL DERECHO: RESULTADO OCR E HISTORIAL -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TARJETA RESULTADO OCR -->
                <Border Grid.Row="0" Style="{StaticResource DarkCardBorderStyle}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="RESULTADO OCR"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Caja destacada para la Patente -->
                        <Border Background="{StaticResource BgPrimaryBrush}"
                                BorderBrush="{StaticResource AccentAmberBrush}"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Padding="16,10"
                                Margin="0,0,0,14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PLACA DETECTADA"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtDetectedPlate"
                                           Text="-"
                                           FontSize="38"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentAmberBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Métricas de Confianza y País -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtConfidencePlate" 
                                       Grid.Column="0" 
                                       Text="Confianza Placa: -" 
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock x:Name="PaisDetectado" 
                                       Grid.Column="1" 
                                       Text="País: -" 
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="ConfianzaPais" 
                                       Grid.Column="2" 
                                       Text="Conf. País: -" 
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- TARJETA HISTORIAL DE LECTURAS -->
                <Border Grid.Row="1" Style="{StaticResource DarkCardBorderStyle}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="HISTORIAL DE LECTURAS"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Últimas detecciones procesadas en esta sesión"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <DataGrid x:Name="PlateDataGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource DarkDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectedCellsChanged="PlateDataGrid_SelectedCellsChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="1.2*"/>
                                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Confianza" Binding="{Binding Confianza}" Width="0.8*"/>
                                <DataGridTemplateColumn Header="Estado" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ColorHex}" 
                                                    Width="18" 
                                                    Height="18" 
                                                    CornerRadius="9"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- TARJETA ACCIONES VEHICULARES -->
                <Border Grid.Row="2" Style="{StaticResource DarkCardBorderStyle}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Consultar Info Vehicular"
                                Style="{StaticResource PrimaryAccentButton}"
                                Click="GetVehicleInfo_Click"/>

                        <Button Grid.Column="2"
                                Content="Exportar CSV"
                                Style="{StaticResource OutlineAmberButton}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== 3. BARRA DE ESTADO INFERIOR ==================== -->
        <Border Grid.Row="2" 
                BorderBrush="{StaticResource BorderSubtleBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="24,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBarReadyText"
                               Text="● Listo"
                               Foreground="#4CAF50"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,16,0"/>

                    <ProgressBar x:Name="OcrProgress"
                                 Style="{StaticResource AmberProgressBarStyle}"
                                 Width="220"
                                 Margin="0,0,16,0"/>

                    <TextBlock x:Name="StatusBarInfo"
                               Text="Esperando acción..."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="© 2026 CIF · Poder Judicial de Formosa"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>


</Window>
