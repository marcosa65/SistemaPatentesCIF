<Window x:Class="SistemaPatentesCIF.views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaPatentesCIF.views"
        mc:Ignorable="d"
        Title="Historial de Detecciones" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->

        <Border Grid.Row="0"
                Background="#252526"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="📚 HISTORIAL DE DETECCIONES"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Registro completo de eventos almacenados"
                           Foreground="#B0B0B0"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        <!-- FILTROS -->

        <Border Grid.Row="1"
                Background="#252526"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Patente:"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBox Grid.Column="1"
                         Height="30"
                         Margin="0,0,10,0"/>

                <Button Grid.Column="2"
                        Content="Buscar"
                        Width="90"
                        Height="30"
                        Margin="0,0,10,0"/>

                <Button Grid.Column="3"
                        Content="Limpiar"
                        Width="90"
                        Height="30"/>

            </Grid>

        </Border>

        <!-- DATAGRID -->

        <Border Grid.Row="2"
                Background="#252526"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,15">

            <DataGrid x:Name="dgDetections"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="#252526"
                      Foreground="White"
                      BorderThickness="0"
                      GridLinesVisibility="None">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Patente"
                                        Binding="{Binding Patente}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Marca"
                                        Binding="{Binding Marca}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Modelo"
                                        Binding="{Binding Modelo}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Fecha"
                                        Binding="{Binding Fecha}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Hora"
                                        Binding="{Binding Hora}"
                                        Width="100"/>

                    <DataGridTextColumn Header="OCR %"
                                        Binding="{Binding Confianza}"
                                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- PIE -->

        <Border Grid.Row="3"
                Background="#252526"
                CornerRadius="10"
                Padding="15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Esperando carga de registros..."
                           Foreground="#B0B0B0"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Total de registros: 0"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>
</Window>
