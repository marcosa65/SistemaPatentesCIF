<Window
  x:Class="SistemaPatentesCIF.views.HistoryWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:SistemaPatentesCIF.views"
  mc:Ignorable="d"
  Title="Historial de Detecciones · ALPR"
  Height="760"
  Width="1040"
  WindowStartupLocation="CenterScreen"
  Style="{StaticResource ModernDarkWindowStyle}"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <!-- 1. Barra Superior Unificada -->
      <RowDefinition Height="Auto" />
      <!-- 2. Barra de Filtros y Búsqueda -->
      <RowDefinition Height="*" />
      <!-- 3. Tabla de Registros (DataGrid) -->
      <RowDefinition Height="Auto" />
      <!-- 4. Barra de Estado / Pie -->
    </Grid.RowDefinitions>

    <!-- ==================== 1. BARRA SUPERIOR UNIFICADA ==================== -->
    <Border
      Grid.Row="0"
      BorderBrush="{StaticResource BorderSubtleBrush}"
      BorderThickness="0,0,0,1"
      Padding="24,14"
    >
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button
            x:Name="BtnBack"
            Content="← Volver"
            Style="{StaticResource SubtleBackButton}"
            Margin="0,0,16,0"
            Click="BtnBack_Click"
          />
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              Text="HISTORIAL DE DETECCIONES"
              Foreground="{StaticResource AccentAmberBrush}"
              FontSize="18"
              FontWeight="Bold"
            />
            <TextBlock
              Text="Registro completo de eventos y lecturas almacenadas en base de datos"
              Foreground="{StaticResource TextSecondaryBrush}"
              FontSize="12"
            />
          </StackPanel>
        </StackPanel>

        <Border
          Style="{StaticResource AmberBadgeBorder}"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
        >
          <TextBlock
            Text="AUDITORÍA · SQL"
            Foreground="{StaticResource TextOnAccentBrush}"
            FontWeight="Bold"
            FontSize="12"
          />
        </Border>
      </Grid>
    </Border>

    <!-- ==================== 2. PANEL DE FILTROS Y BÚSQUEDA ==================== -->
    <Border
      Grid.Row="1"
      Style="{StaticResource DarkCardBorderStyle}"
      Padding="18"
      Margin="24,18,24,14"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="260" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Etiqueta con Icono Vectorial de Búsqueda -->
        <StackPanel
          Grid.Column="0"
          Orientation="Horizontal"
          VerticalAlignment="Center"
          Margin="0,0,14,0"
        >
          <Path
            Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
            Fill="{StaticResource AccentAmberBrush}"
            Width="18"
            Height="18"
            Stretch="Uniform"
            Margin="0,0,8,0"
          />
          <TextBlock
            Text="DOMINIO / PATENTE:"
            Foreground="{StaticResource TextPrimaryBrush}"
            FontWeight="Bold"
            FontSize="13"
            VerticalAlignment="Center"
          />
        </StackPanel>

        <!-- Caja de Búsqueda -->
        <TextBox
          x:Name="TxtFilterPlate"
          Grid.Column="1"
          Style="{StaticResource DarkTextBoxStyle}"
          CharacterCasing="Upper"
          FontSize="16"
          FontWeight="Bold"
          Foreground="{StaticResource AccentAmberBrush}"
          VerticalContentAlignment="Center"
          Margin="0,0,12,0"
          TextChanged="TxtFilterPlate_TextChanged"
        />

        <!-- Botón Secundario Limpiar -->
        <Button
          x:Name="BtnClear"
          Grid.Column="2"
          Content="Restablecer"
          Style="{StaticResource PrimaryAccentButton}"
          Click="BtnClear_Click"
        />

        <!-- Texto de ayuda a la derecha -->
        <TextBlock
          Grid.Column="3"
          Text="Escriba una patente para filtrar por coincidencia parcial o total"
          Foreground="{StaticResource TextSecondaryBrush}"
          FontSize="12"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Margin="20,0,0,0"
        />
      </Grid>
    </Border>

    <!-- ==================== 3. DATAGRID DE REGISTROS ==================== -->
    <Border
      Grid.Row="2"
      Style="{StaticResource DarkCardBorderStyle}"
      Padding="16"
      Margin="24,0,24,14"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado de la tabla -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
          <Path
            Data="M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3"
            Fill="{StaticResource AccentAmberBrush}"
            Width="18"
            Height="18"
            Stretch="Uniform"
            Margin="0,0,8,0"
          />
          <TextBlock
            Text="REGISTROS ALMACENADOS"
            FontSize="14"
            FontWeight="Bold"
            Foreground="{StaticResource TextPrimaryBrush}"
            VerticalAlignment="Center"
          />
        </StackPanel>

        <!-- Tabla estilizada para aceptar Theme -->
        <DataGrid
          x:Name="dgDetections"
          Grid.Row="1"
          Style="{StaticResource DarkDataGridStyle}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
        >
          <DataGrid.Columns>
            <DataGridTextColumn
              Header="Patente"
              Binding="{Binding Plate}"
              Width="*"
              FontWeight="Bold"
            />

            <DataGridTextColumn Header="Confianza" Binding="{Binding Confidence}" Width="*" />

            <DataGridTextColumn Header="País" Binding="{Binding Country}" Width="*" />

            <DataGridTextColumn
              Header="Fecha y Hora"
              Binding="{Binding DetectionDate}"
              Width="180"
            />
            
              <DataGridTemplateColumn Header="Ficha Vehicular" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button
                    Style="{StaticResource DataGridActionButton}"
                    IsEnabled="{Binding HasVehicleInfo}"
                    Click="BtnViewDetail_Click"
                    ToolTip="Ver datos registrales y radicación"
                  >
                    <StackPanel Orientation="Horizontal">
                      <Path
                        Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Width="14"
                        Height="14"
                        Stretch="Uniform"
                        Margin="0,0,6,0"
                      />
                      <TextBlock Text="Ver Ficha" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- ==================== 4. BARRA DE ESTADO / PIE ==================== -->
    <Border
      Grid.Row="3"
      BorderBrush="{StaticResource BorderSubtleBrush}"
      BorderThickness="0,1,0,0"
      Padding="24,12"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="● " Foreground="#4CAF50" FontWeight="Bold" FontSize="13" />
          <TextBlock
            x:Name="TxtStatusMessage"
            Text="Esperando carga de registros..."
            Foreground="{StaticResource TextSecondaryBrush}"
            FontSize="13"
          />
        </StackPanel>

        <Border
          Grid.Column="1"
          Background="{StaticResource BgSecondaryBrush}"
          BorderBrush="{StaticResource BorderSubtleBrush}"
          BorderThickness="1"
          CornerRadius="6"
          Padding="12,5"
        >
          <TextBlock
            x:Name="TxtTotalRecords"
            Text="Total de registros: 0"
            FontWeight="Bold"
            FontSize="13"
            Foreground="{StaticResource AccentAmberBrush}"
          />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
