<Window x:Class="SistemaPatentesCIF.views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaPatentesCIF.views"
        mc:Ignorable="d"
        Title="Configuración del Sistema · ALPR"
        Height="820"
        Width="980"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernDarkWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Barra Superior -->
            <RowDefinition Height="*"/>
            <!-- Contenido Principal -->
            <RowDefinition Height="Auto"/>
            <!-- Barra Inferior de Acciones -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. BARRA SUPERIOR UNIFICADA ==================== -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBack"
                            Content="← Volver"
                            Style="{StaticResource SubtleBackButton}"
                            Margin="0,0,16,0"
                            Click="BtnBack_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CONFIGURACIÓN DEL SISTEMA"
                                   Foreground="{DynamicResource AccentAmberBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Personalización visual, parámetros de cámara y conexiones"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource AmberBadgeBorder}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="PREFERENCIAS · ALPR"
                               Foreground="{DynamicResource TextOnAccentBrush}"
                               FontWeight="Bold"
                               FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 2. CONTENIDO PRINCIPAL ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel>

                <!-- BLOQUE A: SELECTOR DE TEMAS VISUALES -->
                <Border Style="{StaticResource DarkCardBorderStyle}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Data="M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A1.5,1.5 0 0,0 13.5,19.5C13.5,19.11 13.35,18.76 13.11,18.5C12.88,18.23 12.73,17.88 12.73,17.5A1.5,1.5 0 0,1 14.23,16H16A5,5 0 0,0 21,11C21,6.58 16.97,3 12,3M6.5,12A1.5,1.5 0 0,1 5,10.5A1.5,1.5 0 0,1 6.5,9A1.5,1.5 0 0,1 8,10.5A1.5,1.5 0 0,1 6.5,12M9.5,8A1.5,1.5 0 0,1 8,6.5A1.5,1.5 0 0,1 9.5,5A1.5,1.5 0 0,1 11,6.5A1.5,1.5 0 0,1 9.5,8M14.5,8A1.5,1.5 0 0,1 13,6.5A1.5,1.5 0 0,1 14.5,5A1.5,1.5 0 0,1 16,6.5A1.5,1.5 0 0,1 14.5,8M17.5,12A1.5,1.5 0 0,1 16,10.5A1.5,1.5 0 0,1 17.5,9A1.5,1.5 0 0,1 19,10.5A1.5,1.5 0 0,1 17.5,12Z"
                                  Fill="{DynamicResource AccentAmberBrush}"
                                  Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="APARIENCIA Y TEMA DE INTERFAZ"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Selecciona una paleta de colores. El cambio se aplica en tiempo real a todas las ventanas abiertas."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,14"/>

                        <UniformGrid Rows="1" Columns="4" Margin="-6,0">

                            <!-- TEMA 1: BATMAN -->
                            <Button x:Name="BtnThemeBatman"
                                    Tag="BatmanTheme"
                                    Style="{StaticResource DashboardTileButton}"
                                    Margin="6"
                                    Padding="14"
                                    Click="BtnTheme_Click">
                                <StackPanel>
                                    <!-- Muestra de colores -->
                                    <Border Background="#0C0D12" BorderBrush="#262934" BorderThickness="1" CornerRadius="6" Height="44" Width="130" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="16" Height="16" Fill="#15171E" Stroke="#262934" StrokeThickness="1" Margin="0,0,6,0"/>
                                            <Ellipse Width="16" Height="16" Fill="#F5B800"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Batman" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Oscuro · Ámbar" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- TEMA 2: SUPERMAN -->
                            <Button x:Name="BtnThemeSuperman"
                                    Tag="SupermanTheme"
                                    Style="{StaticResource DashboardTileButton}"
                                    Margin="6"
                                    Padding="14"
                                    Click="BtnTheme_Click">
                                <StackPanel>
                                    <Border Background="#0B1120" BorderBrush="#27385E" BorderThickness="1" CornerRadius="6" Height="44" Width="130" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="16" Height="16" Fill="#131C31" Stroke="#27385E" StrokeThickness="1" Margin="0,0,6,0"/>
                                            <Ellipse Width="16" Height="16" Fill="#DC2626"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Superman" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Azul Noche · Carmesí" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- TEMA 3: JOKER -->
                            <Button x:Name="BtnThemeJoker"
                                    Tag="JokerTheme"
                                    Style="{StaticResource DashboardTileButton}"
                                    Margin="6"
                                    Padding="14"
                                    Click="BtnTheme_Click">
                                <StackPanel>
                                    <Border Background="#0D0914" BorderBrush="#332352" BorderThickness="1" CornerRadius="6" Height="44" Width="130" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="16" Height="16" Fill="#171024" Stroke="#332352" StrokeThickness="1" Margin="0,0,6,0"/>
                                            <Ellipse Width="16" Height="16" Fill="#00E676"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Joker" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Púrpura · Verde Neón" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- TEMA 4: NIGHTWING -->
                            <Button x:Name="BtnThemeNightwing"
                                    Tag="NightwingTheme"
                                    Style="{StaticResource DashboardTileButton}"
                                    Margin="6"
                                    Padding="14"
                                    Click="BtnTheme_Click">
                                <StackPanel>
                                    <Border Background="#080C14" BorderBrush="#233554" BorderThickness="1" CornerRadius="6" Height="44" Width="130" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="16" Height="16" Fill="#0F1624" Stroke="#233554" StrokeThickness="1" Margin="0,0,6,0"/>
                                            <Ellipse Width="16" Height="16" Fill="#00E5FF"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Nightwing" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Pizarra · Cian Eléctrico" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- BLOQUE B: PARÁMETROS OPERATIVOS (2 COLUMNAS) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUMNA IZQUIERDA: CÁMARA Y OCR -->
                    <Border Grid.Column="0" Style="{StaticResource DarkCardBorderStyle}" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Path Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"
                                      Fill="{DynamicResource AccentAmberBrush}"
                                      Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="CÁMARA Y RECONOCIMIENTO OCR"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="URL Stream RTSP / Índice de Cámara Local"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtCameraSource"
                                     Text="rtsp://192.168.1.50:554/stream1"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="Umbral Mínimo de Confianza OCR (%)"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtMinConfidence"
                                     Text="80"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Margin="0,0,0,14"/>

                            <CheckBox x:Name="ChkAutoSaveDetections"
                                      Content="Guardar detecciones válidas automáticamente en SQL"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      IsChecked="True"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- COLUMNA DERECHA: API VEHICULAR Y ARCHIVOS -->
                    <Border Grid.Column="2" Style="{StaticResource DarkCardBorderStyle}" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Path Data="M4,6H20V16H4M20,18A2,2 0 0,0 22,16V6C22,4.89 21.1,4 20,4H4C2.89,4 2,4.89 2,6V16A2,2 0 0,0 4,18H0V20H24V18H20Z"
                                      Fill="{DynamicResource AccentAmberBrush}"
                                      Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="API VEHICULAR Y EXPORTACIÓN"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Endpoint de Consulta Registral"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtApiUrl"
                                     Text="https://api.clasific.ar/v1/vehiculos"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="Carpeta Predeterminada para Informes y Capturas"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtExportPath"
                                         Text="C:\CIF\ALPR\Exportaciones"
                                         Style="{StaticResource DarkTextBoxStyle}"/>
                                <Button x:Name="BtnBrowseExport"
                                        Grid.Column="2"
                                        Content="Examinar..."
                                        Style="{StaticResource SubtleBackButton}"
                                        Padding="12,10"/>
                            </Grid>

                            <CheckBox x:Name="ChkSandboxMode"
                                      Content="Usar entorno de pruebas (Sandbox) para consultas API"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      IsChecked="False"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 3. PIE DE VENTANA Y GUARDADO ==================== -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Button x:Name="BtnResetDefaults"
                        Content="Restaurar Valores por Defecto"
                        Style="{StaticResource SubtleBackButton}"
                        HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtSaveStatus"
                               Text=""
                               Foreground="{DynamicResource AccentAmberBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button x:Name="BtnSaveSettings"
                            Content="Guardar Configuración"
                            Style="{StaticResource PrimaryAccentButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
