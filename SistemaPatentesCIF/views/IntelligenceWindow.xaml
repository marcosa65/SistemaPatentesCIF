<Window x:Class="SistemaPatentesCIF.views.IntelligenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaPatentesCIF.views"
        mc:Ignorable="d"
        Title="Centro de Inteligencia"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->

        <Border Grid.Row="0"
                Background="#252526"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="📊 CENTRO DE INTELIGENCIA"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Métricas operativas y análisis de actividad"
                           Foreground="#B0B0B0"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        <!-- KPI -->

        <UniformGrid Grid.Row="1"
                     Rows="1"
                     Columns="3"
                     Margin="0,0,0,15">

            <!-- HOY -->

            <Border Background="#252526"
                    CornerRadius="10"
                    Margin="5"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="HOY"
                               Foreground="#B0B0B0"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="txtHoy"
                               Text="0"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#007ACC"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <!-- UNICOS -->

            <Border Background="#252526"
                    CornerRadius="10"
                    Margin="5"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="VEHÍCULOS ÚNICOS"
                               Foreground="#B0B0B0"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="txtUnicos"
                               Text="0"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#00C853"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <!-- ALERTAS -->

            <Border Background="#252526"
                    CornerRadius="10"
                    Margin="5"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="ALERTAS"
                               Foreground="#B0B0B0"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="txtAlertas"
                               Text="0"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#FFB300"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- TOP VEHICULOS -->

        <Border Grid.Row="2"
                Background="#252526"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="🏆 Vehículos Más Observados"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>

                <ListView Grid.Row="1"
                          Margin="0,15,0,0"
                          Background="#252526"
                          Foreground="White"
                          BorderThickness="0">

                    <ListViewItem>
                        Sin datos disponibles
                    </ListViewItem>

                </ListView>

            </Grid>

        </Border>

        <!-- ACTIVIDAD -->

        <Border Grid.Row="3"
                Background="#252526"
                CornerRadius="10"
                Padding="15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📈 Actividad del Sistema"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="Sin registros disponibles"
                               Foreground="#B0B0B0"
                               HorizontalAlignment="Center"
                               FontSize="16"/>

                    <TextBlock Text="Las estadísticas aparecerán automáticamente cuando existan detecciones almacenadas."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#707070"
                               Margin="20,10,20,0"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</Window>
