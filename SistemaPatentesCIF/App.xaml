<Application x:Class="SistemaPatentesCIF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SistemaPatentesCIF"
             StartupUri="/Views/InitialWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Paleta de colores activa (cámbiala por el tema que quieras usar) -->
                <ResourceDictionary Source="/themes/BatmanTheme.xaml"/>

                <!-- 2. Estructura y estilos base compartidos -->
                <ResourceDictionary Source="/themes/BaseStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>
